pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        NEW_VERSION = "1.0.0-ubuntu"
    }

    stages {

        stage('Build') {
            steps {
                echo "Building application, version ${env.NEW_VERSION}"
                sh "mvn -version"
            }
        }

        stage('Test') {
            when {
                expression {
                    env.BRANCH_NAME == 'dev' || env.BRANCH_NAME == 'master'
                }
            }
            steps {
                echo "Testing the application on branch ${env.BRANCH_NAME}"
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the application'
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-repo',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                        """
                    }
                }
            }
        }

    } // end stages

    post {
        always {
            echo "Build number: ${env.BUILD_NUMBER}, branch: ${env.BRANCH_NAME}"
        }
        success {
            echo 'Post: build succeeded'
        }
        failure {
            echo 'Post: build failed'
        }
    }
}
