pipeline {
    agent any
stages {
        stage('Build') {
            steps {
                echo 'Building the application'
            }
        }
        stage('Test') {
    when {
        expression {
            // Only run tests on 'dev' or 'master'
            env.BRANCH_NAME == 'dev' || env.BRANCH_NAME == 'master'
        }
    }
    steps {
        echo "Testing the application on branch ${env.BRANCH_NAME}"
    }
}
        stage('Deploy') {
            steps {
                echo 'Deploying the application'
            }
        }
    }
post {
        always {
            echo 'Post: always run (cleanup, notifications, etc.)'
        }
        success {
            echo 'Post: build succeeded'
        }
        failure {
            echo 'Post: build failed'
        }
    }
}

