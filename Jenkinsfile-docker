pipeline {
    agent { label 'ec2-agent-01' }

    environment {
        COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
        BUILD  = "${env.BUILD_NUMBER}"
        IMAGE  = "977919068499.dkr.ecr.eu-west-2.amazonaws.com/munib-demo"
    }

    stages {

        stage('Maven Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t munib-demo:${COMMIT} .
                    docker tag munib-demo:${COMMIT} ${IMAGE}:${COMMIT}
                    docker tag munib-demo:${COMMIT} ${IMAGE}:${BUILD}
                    docker tag munib-demo:${COMMIT} ${IMAGE}:latest
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region eu-west-2 \
                        | docker login \
                            --username AWS \
                            --password-stdin \
                            977919068499.dkr.ecr.eu-west-2.amazonaws.com
                '''
            }
        }

        stage('Push Images') {
            steps {
                sh '''
                    docker push ${IMAGE}:${COMMIT}
                    docker push ${IMAGE}:${BUILD}
                    docker push ${IMAGE}:latest
                '''
            }
        }
    }
}

