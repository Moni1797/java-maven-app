pipeline {
    agent { label 'ec2-agent-01' }

    stages {

        stage('Maven Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t munib-demo .'
            }
        }

        stage('Tag & Push') {
            steps {
                sh '''
                    aws ecr get-login-password --region eu-west-2 \
                        | docker login \
                            --username AWS \
                            --password-stdin \
                            977919068499.dkr.ecr.eu-west-2.amazonaws.com

                    docker tag munib-demo:latest \
                        977919068499.dkr.ecr.eu-west-2.amazonaws.com/munib-demo:latest

                    docker push \
                        977919068499.dkr.ecr.eu-west-2.amazonaws.com/munib-demo:latest
                '''
            }
        }
    }
}

